# Copy this file as .env for local development. Never upload .env or share its secrets.
# Leave DATABASE_URL empty to use local JSON storage for testing on this computer.
DATABASE_URL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
ADMIN_NAME=Ақшабаева Сымбат
DATABASE_SSL=false
# Optional: enables generative AI answers and full automatic RU/EN translations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TRANSLATION_MODEL=gpt-5-mini
